@model CreateCategoryDto
@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Yeni Kategori Ekleme İçerik Alanı -->
<div class="p-6 md:p-10 max-w-4xl mx-auto w-full">
    <!-- Başlık ve Açıklama -->
    <div class="mb-8">
        <div class="flex items-center gap-2 text-sm text-slate-500 mb-2 font-medium">
            <span>Kategori Yönetimi</span>
            <span class="material-symbols-outlined text-sm">chevron_right</span>
            <span class="text-purple-600 font-semibold">Yeni Kategori Ekle</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900 tracking-tight">Yeni Kategori Ekle</h1>
        <p class="text-slate-500 text-sm md:text-base mt-1.5">
            Kullanıcıların ve departmanların mesajlaşma kanallarını organize etmek için yeni bir kategori tanımlayın.
        </p>
    </div>

    <!-- Form Kartı -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200/80 p-6 md:p-9 transition-all">
        <form asp-controller="Category" asp-action="CreateCategory" method="post" class="space-y-7">

            <!-- Input 1: Kategori Adı -->
            <div>
                <label for="categoryName" class="block text-sm font-semibold text-slate-800 mb-2">
                    Kategori Adı <span class="text-rose-500">*</span>
                </label>
                <div class="relative">
                    <input type="text"
                           id="categoryName"
                           asp-for = "CategoryName"
                           placeholder="Örn: Yapay Zeka & İnovasyon"
                           class="w-full px-4 py-3 bg-white border border-slate-200 rounded-lg text-slate-800 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-600/20 focus:border-purple-600 transition-colors shadow-none"
                           required />
                </div>
            </div>

            <!-- Input 2: Kategori Rengi -->
            <div>
                <label for="Color" class="block text-sm font-semibold text-slate-800 mb-2">
                    Kategori Rengi <span class="text-rose-500">*</span>
                </label>
                <div class="flex items-center gap-3">
                    <!-- Renk Seçici Kutusu (type="color") -->
                    <div class="relative flex items-center justify-center w-12 h-11 rounded-lg border border-slate-200 bg-slate-50 overflow-hidden cursor-pointer hover:border-slate-300 transition-colors shadow-none">
                        <input type="color"
                               id="categoryColor"
                               asp-for="Color"
                               class="absolute inset-0 w-[150%] h-[150%] -top-1/4 -left-1/4 cursor-pointer opacity-100 border-0 p-0"
                               oninput="document.getElementById('categoryColorHex').value = this.value" />
                    </div>

                    <!-- Hex Kodu Metin Alanı -->
                    <div class="relative flex-1">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 font-mono text-sm">
                            #
                        </span>
                        <input type="text"
                               id="categoryColorHex"
                               asp-for="Color"
                               placeholder="7c3aed"
                               maxlength="7"
                               class="w-full pl-8 pr-4 py-3 bg-white border border-slate-200 rounded-lg text-slate-800 text-sm font-mono placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-600/20 focus:border-purple-600 transition-colors"
                               oninput="let val = this.value.replace('#',''); if(val.length===6) document.getElementById('categoryColor').value = '#' + val;" />
                    </div>
                </div>
                <p class="text-xs text-slate-400 mt-1.5 font-normal">Kanal simgesi, etiket rozetleri ve bildirim noktalarında bu renk vurgusu kullanılacaktır.</p>
            </div>

            <!-- Input 3: Kategori İkonu -->
            <div>
                <label for="CategoryIcon" class="block text-sm font-semibold text-slate-800 mb-2">
                    Kategori İkonu <span class="text-rose-500">*</span>
                </label>
                <div class="relative flex items-center">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
                        <span id="iconPreview" class="material-symbols-outlined text-xl text-purple-600"></span>
                    </div>
                    <input type="text"
                           id="categoryIcon"
                           asp-for="CategoryIcon"
                           placeholder="Örn: folder, work, forum, lightbulb"
                           class="w-full pl-11 pr-4 py-3 bg-white border border-slate-200 rounded-lg text-slate-800 text-sm font-mono placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-600/20 focus:border-purple-600 transition-colors"
                           oninput="document.getElementById('iconPreview').innerText = this.value.trim() || 'help_outline'"
                           required />
                </div>
                <p class="text-xs text-slate-400 mt-1.5">
                    <a href="https://fonts.google.com/icons" target="_blank" rel="noopener noreferrer" class="text-purple-600 hover:text-purple-700 underline font-medium">Google Material Symbols</a> kütüphanesindeki ikon adını girin (Örn: <code class="bg-slate-100 text-slate-600 px-1 py-0.5 rounded text-[11px]">folder</code>, <code class="bg-slate-100 text-slate-600 px-1 py-0.5 rounded text-[11px]">work</code>, <code class="bg-slate-100 text-slate-600 px-1 py-0.5 rounded text-[11px]">forum</code>, <code class="bg-slate-100 text-slate-600 px-1 py-0.5 rounded text-[11px]">rocket_launch</code>).
                </p>
            </div>

            <!-- Ayırıcı Çizgi -->
            <div class="pt-2 border-t border-slate-100"></div>

            <!-- Butonlar (İptal Et & Kaydet) -->
            <div class="flex items-center justify-end gap-3 pt-2">
                <a asp-controller="Category" asp-action="Index"
                        class="px-5 py-2.5 rounded-lg border border-slate-200 text-slate-600 bg-white hover:bg-slate-50 hover:text-slate-800 text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200">
                    İptal Et
                </a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-purple-600 hover:bg-purple-700 active:bg-purple-800 text-white text-sm font-semibold transition-all shadow-sm shadow-purple-600/20 focus:outline-none focus:ring-2 focus:ring-purple-600/30">
                    <span class="material-symbols-outlined text-lg">check</span>
                    <span>Kaydet</span>
                </button>
            </div>

        </form>
    </div>
</div>


