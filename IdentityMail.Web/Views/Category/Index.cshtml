
@model List<ListCategoryDto>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!-- ========================================================================= -->
<!-- 3. KATEGORİ YÖNETİMİ BÖLÜMÜ (#view-categories)                            -->
<!-- ========================================================================= -->
<section class="view-section space-y-6" id="view-categories">
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-soft overflow-hidden">
        <!-- Başlık alanı: "Mesajlaşma Kategorileri & Kanallar", sağında "+ Yeni Kategori Ekle" -->
        <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-lg font-bold text-slate-900">Mesajlaşma Kategorileri</h2>
                
            </div>
            <!-- + Yeni Kategori Ekle Butonu -->
            <a asp-controller="Category" asp-action="CreateCategory" class="bg-purple-600 hover:bg-purple-700 text-white rounded-lg px-4 py-2 flex items-center gap-2 text-xs font-semibold shadow-sm shadow-purple-600/30 transition-all self-start sm:self-auto">
                <span class="material-symbols-outlined text-base">add_circle</span>
                <span>Yeni Kategori Ekle</span>
            </a>
        </div>
        <!-- Kategoriler Tablosu -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-400 uppercase font-semibold text-[10px] tracking-wider border-b border-slate-100">
                    <tr>
                        <th class="py-3 px-6">Kategori Adı &amp; İkonu</th>
                        <th class="py-3 px-6">Renk Belirteci</th>
                        <th class="py-3 px-6 text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700">
                    @foreach(var item in Model)
                    {
                        <!-- Kategori 1: İş & Planlama -->
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center">
                                        <span class="material-symbols-outlined text-base">@item.CategoryIcon</span>
                                    </div>
                                    <span class="font-bold text-slate-900">@item.CategoryName</span>
                                </div>
                            </td>
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-3.5 rounded-full" style= "background-color: @item.Color;"></span>
                                    <span class="font-mono text-[11px] text-slate-500">@item.Color</span>
                                </div>
                            </td>
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a asp-controller="Category" asp-action="UpdateCategory" asp-route-id="@item.Id" class="p-1.5 text-slate-500 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors" title="Düzenle">
                                        <span class="material-symbols-outlined text-base">edit</span>
                                    </a>
                                    <a asp-controller="Category" asp-action="DeleteCategory" asp-route-id="@item.Id" class="p-1.5 text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Sil">
                                        <span class="material-symbols-outlined text-base">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    
                </tbody>
            </table>
        </div>
    </div>
</section>

