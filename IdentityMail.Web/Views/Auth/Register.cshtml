
@model RegisterDto
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="tr" style="">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Kayıt Ol - NovaConnect</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-tertiary-fixed-variant": "#24502c",
                        "primary-fixed-dim": "#d3bcfc",
                        "surface-container-high": "#e7e8e9",
                        "on-primary-fixed-variant": "#503d73",
                        "on-secondary-fixed-variant": "#004d65",
                        "surface-dim": "#d9dadb",
                        "inverse-primary": "#d3bcfc",
                        "outline": "#7a7580",
                        "on-secondary": "#ffffff",
                        "on-error-container": "#93000a",
                        "tertiary-fixed-dim": "#a2d3a4",
                        "secondary-container": "#84d7fd",
                        "surface-container-highest": "#e1e3e4",
                        "on-surface": "#191c1d",
                        "on-primary": "#ffffff",
                        "inverse-on-surface": "#f0f1f2",
                        "secondary": "#006685",
                        "tertiary": "#3c6842",
                        "on-tertiary": "#ffffff",
                        "background": "#f8f9fa",
                        "primary": "#68548d",
                        "surface": "#f8f9fa",
                        "on-primary-container": "#453268",
                        "surface-container": "#edeeef",
                        "secondary-fixed-dim": "#7ed1f7",
                        "inverse-surface": "#2e3132",
                        "surface-tint": "#68548d",
                        "on-secondary-container": "#005d79",
                        "on-secondary-fixed": "#001f2a",
                        "on-surface-variant": "#49454f",
                        "surface-container-low": "#f3f4f5",
                        "on-tertiary-fixed": "#002109",
                        "on-primary-fixed": "#230f45",
                        "on-tertiary-container": "#194523",
                        "error-container": "#ffdad6",
                        "outline-variant": "#cbc4d0",
                        "primary-fixed": "#ebdcff",
                        "surface-bright": "#f8f9fa",
                        "secondary-fixed": "#bee9ff",
                        "tertiary-container": "#83b386",
                        "on-error": "#ffffff",
                        "surface-container-lowest": "#ffffff",
                        "on-background": "#191c1d",
                        "error": "#ba1a1a",
                        "primary-container": "#b39ddb",
                        "tertiary-fixed": "#bdefbe",
                        "surface-variant": "#e1e3e4"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "xl": "32px",
                        "sidebar-width": "280px",
                        "container-max": "1200px",
                        "xs": "4px",
                        "base": "8px",
                        "sm": "12px",
                        "md": "16px",
                        "lg": "24px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Inter"],
                        "headline-xl": ["Inter"],
                        "body-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "label-bold": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "title-md": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "label-bold": ["12px", { "lineHeight": "16px", "fontWeight": "600" }],
                        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body class="bg-background min-h-screen flex text-on-surface font-body-lg">
    <div class="flex w-full min-h-screen">
        <!-- Left Side: Pastel Premium & Abstract CSS Art -->
        <div class="hidden lg:flex w-1/2 relative flex-col p-12 bg-gradient-to-br from-indigo-50 via-white to-purple-50 overflow-hidden border-r border-purple-100/50">

            <!-- Pastel Işık Küreleri (Arka Plan) -->
            <div class="absolute top-0 left-0 w-full h-full pointer-events-none z-0">
                <div class="absolute -top-[10%] -left-[10%] w-[70%] h-[70%] rounded-full bg-purple-200/50 blur-[80px]"></div>
                <div class="absolute bottom-[5%] -right-[15%] w-[60%] h-[60%] rounded-full bg-blue-200/40 blur-[80px]"></div>
            </div>

            <!-- Üst Sol Logo -->
            <div class="relative z-20 flex items-center gap-3 w-full">
                <div class="w-12 h-12 rounded-xl bg-purple-600 flex items-center justify-center shadow-lg shadow-purple-600/30">
                    <span class="material-symbols-outlined text-white text-2xl" style="font-variation-settings: 'FILL' 1;">diversity_3</span>
                </div>
                <h1 class="text-3xl font-black text-slate-800 tracking-tight">NovaConnect</h1>
            </div>

            <!-- MERKEZİ KISIM (Görsel ve Yazı Bir Arada, Tam Ortalanmış) -->
            <div class="flex-1 flex flex-col items-center justify-center relative z-10 w-full">

                <!-- GÖRSEL ALAN -->
                <div class="relative w-full max-w-sm flex items-center justify-center h-80 mb-8">

                    <!-- Arkadaki Radar / Dalga Çemberleri -->
                    <div class="absolute w-64 h-64 border border-purple-200/60 rounded-full"></div>
                    <div class="absolute w-96 h-96 border border-blue-200/40 rounded-full"></div>
                    <div class="absolute w-[30rem] h-[30rem] border border-pink-100/30 rounded-full"></div>

                    <!-- 1. Üst Sağ Mesaj Kartı -->
                    <div class="absolute top-2 -right-6 w-64 h-20 bg-white/70 backdrop-blur-md rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-white flex items-center p-3 transform rotate-6 z-10">
                        <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                            <span class="material-symbols-outlined text-indigo-400 text-sm">person</span>
                        </div>
                        <div class="ml-3 flex-1">
                            <div class="h-2.5 bg-slate-200 rounded-full w-3/4 mb-2"></div>
                            <div class="h-1.5 bg-slate-100 rounded-full w-1/2"></div>
                        </div>
                    </div>

                    <!-- Ana Zarf İkonu (Merkez) -->
                    <div class="w-36 h-36 bg-gradient-to-tr from-purple-500 to-blue-400 rounded-3xl shadow-2xl shadow-purple-500/20 flex items-center justify-center relative z-20 animate-[bounce_6s_infinite]">
                        <span class="material-symbols-outlined text-white text-[80px] drop-shadow-md">mail</span>
                        <div class="absolute -top-3 -right-3 w-8 h-8 bg-pink-500 rounded-full border-4 border-white shadow-md"></div>
                    </div>

                    <!-- 2. Sol Alt Mesaj Kartı -->
                    <div class="absolute bottom-4 -left-12 w-72 h-24 bg-white/80 backdrop-blur-xl rounded-2xl shadow-[0_15px_35px_rgb(0,0,0,0.1)] border border-white flex items-center p-4 transform -rotate-3 z-30">
                        <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                            <span class="material-symbols-outlined text-purple-500">mark_email_unread</span>
                        </div>
                        <div class="ml-4 flex-1">
                            <div class="h-3 bg-slate-200 rounded-full w-full mb-2.5"></div>
                            <div class="h-2 bg-slate-100 rounded-full w-2/3 mb-1.5"></div>
                            <div class="h-2 bg-slate-100 rounded-full w-4/5"></div>
                        </div>
                    </div>


                </div>

                <!-- YAZI ALANI (Görselin hemen altına geldi) -->
                <div class="text-center mt-6">
                    <h2 class="text-3xl font-black text-slate-800 mb-3">Aramıza Katılın</h2>
                    <p class="text-slate-500 font-medium max-w-xs mx-auto">
                        Kurumsal iletişimin en renkli ve ferah hali. İş akışınızı hemen başlatın.
                    </p>
                </div>

            </div>

        </div>
        <!-- Right Side: Sign Up Form -->
        <div class="w-full lg:w-1/2 flex flex-col justify-center items-center p-md lg:p-xl bg-surface relative z-10 shadow-[-10px_0_30px_rgba(0,0,0,0.02)]">
            <div class="w-full max-w-sm">
                <!-- Mobile Logo -->
                <div class="lg:hidden flex items-center justify-center gap-sm mb-xl">
                    <span class="material-symbols-outlined text-headline-lg-mobile text-primary" style="font-variation-settings: 'FILL' 1;">diversity_3</span>
                    <h1 class="font-headline-lg-mobile text-headline-lg-mobile text-primary tracking-tight">NovaConnect</h1>
                </div>
                <div class="mb-xl text-center lg:text-left">
                    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs hidden lg:block">Hesap Oluştur</h2>
                    <h2 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface mb-xs lg:hidden">Hesap Oluştur</h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Lütfen bilgilerinizi girerek kayıt olun.</p>
                </div>
                <form asp-controller ="Auth" asp-action="Register" method="post" class="space-y-md w-full">
                    <div asp-validation-summary="All" class="text-error"> </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-bold text-label-bold text-on-surface" for="firstName">Ad</label>
                        <div class="relative">
                            <i class="material-symbols-outlined material-icons absolute left-4 top-1/2 -translate-y-1/2 text-[#b39ddb]">person</i>
                            <input class="w-full pl-12 pr-md py-sm rounded-lg border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary-fixed-dim transition-all outline-none font-body-sm text-body-sm placeholder:text-on-surface-variant/50" asp-for="FirstName" placeholder="Örn: Ayşe" type="text" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-bold text-label-bold text-on-surface" for="lastName">Soyad</label>
                        <div class="relative">
                            <i class="material-symbols-outlined material-icons absolute left-4 top-1/2 -translate-y-1/2 text-[#b39ddb]">person</i>
                            <input class="w-full pl-12 pr-md py-sm rounded-lg border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary-fixed-dim transition-all outline-none font-body-sm text-body-sm placeholder:text-on-surface-variant/50" asp-for="LastName" placeholder="Örn: Yılmaz" type="text" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-bold text-label-bold text-on-surface" for="username">Kullanıcı Adı</label>
                        <div class="relative">
                            <i class="material-symbols-outlined material-icons absolute left-4 top-1/2 -translate-y-1/2 text-[#b39ddb]">alternate_email</i>
                            <input class="w-full pl-12 pr-md py-sm rounded-lg border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary-fixed-dim transition-all outline-none font-body-sm text-body-sm placeholder:text-on-surface-variant/50" asp-for="UserName" placeholder="ayseyilmaz" type="text" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-bold text-label-bold text-on-surface" for="email">E-posta</label>
                        <div class="relative">
                            <i class="material-symbols-outlined material-icons absolute left-4 top-1/2 -translate-y-1/2 text-[#b39ddb]">email</i>
                            <input class="w-full pl-12 pr-md py-sm rounded-lg border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary-fixed-dim transition-all outline-none font-body-sm text-body-sm placeholder:text-on-surface-variant/50" asp-for="Email" placeholder="ornek@sirket.com" type="email" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-bold text-label-bold text-on-surface" for="password">Şifre</label>
                        <div class="relative">
                            <i class="material-symbols-outlined material-icons absolute left-4 top-1/2 -translate-y-1/2 text-[#b39ddb]">lock</i>
                            <input class="w-full pl-12 pr-xl py-sm rounded-lg border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary-fixed-dim transition-all outline-none font-body-sm text-body-sm placeholder:text-on-surface-variant/50" asp-for="Password" placeholder="En az 8 karakter" type="password" />
                            <button aria-label="Toggle password visibility" class="absolute right-md top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface transition-colors focus:outline-none" type="button">
                                <span class="material-symbols-outlined">visibility_off</span>
                            </button>
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-bold text-label-bold text-on-surface" for="passwordConfirm">Şifre Tekrarı</label>
                        <div class="relative">
                            <i class="material-symbols-outlined material-icons absolute left-4 top-1/2 -translate-y-1/2 text-[#b39ddb]">lock_reset</i>
                            <input class="w-full pl-12 pr-xl py-sm rounded-lg border border-outline-variant bg-surface-container-lowest focus:border-secondary focus:ring-2 focus:ring-secondary-fixed-dim transition-all outline-none font-body-sm text-body-sm placeholder:text-on-surface-variant/50" asp-for="ConfirmPassword" placeholder="Şifrenizi tekrar girin" type="password" />
                        </div>
                    </div>
                    <button class="w-full mt-lg py-sm px-lg bg-primary text-on-primary rounded-full font-label-bold text-label-bold hover:bg-on-primary-container transition-all active:scale-[0.98] shadow-sm flex items-center justify-center gap-xs" type="submit">
                        <span class="">Kayıt Ol</span>
                        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                    </button>
                </form>
                <div class="mt-xl text-center">
                    <p class="font-body-sm text-body-sm text-on-surface-variant">
                        Zaten bir hesabınız var mı?
                        <a class="font-label-bold text-label-bold text-primary hover:text-on-primary-container underline underline-offset-4 transition-colors" href="/Auth/Login/">Giriş Yap</a>
                    </p>
                </div>
                <div class="mt-xl pt-lg border-t border-surface-container-high text-center">
                    <p class="font-label-sm text-label-sm text-outline">Kayıt olarak Gizlilik Politikası ve Kullanım Şartları'nı kabul etmiş olursunuz.</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>



