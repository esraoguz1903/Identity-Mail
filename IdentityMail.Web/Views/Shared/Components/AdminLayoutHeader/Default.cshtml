
@{
    Layout = null;
}

<header class="h-16 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-6 md:px-8 flex items-center justify-between sticky top-0 z-20">
    <!-- Sol taraf: Aktif Sekme Başlığı ve Dinamik Açıklama -->
    <div>
        <h1 class="text-base md:text-lg font-bold text-slate-900 leading-tight" id="header-title">@ViewData["Title"]</h1>
    </div>
    <!-- Sağ taraf: Arama çubuğu / Bildirim Zili, Yönetici Profil Kartı, Çıkış Yap Butonu -->
    <div class="flex items-center gap-3 sm:gap-5">
        <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>
        <!-- Yönetici Profil Kartı (Ahmet Yılmaz, 'Süper Admin' rozeti, 'AY' avatarı) -->
        <div class="flex items-center gap-2.5">
            <div class="relative">
                <div class="w-9 h-9 rounded-full bg-purple-100 border border-purple-200 text-purple-700 font-bold text-xs flex items-center justify-center">
                    KO
                </div>
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 rounded-full ring-2 ring-white"></span>
            </div>
            <div class="hidden sm:block text-left">
                <div class="text-xs font-bold text-slate-900 leading-tight">Kadir Oğuz</div>
                <div class="text-[11px] font-semibold text-purple-600"> Admin</div>
            </div>
        </div>
        <!-- Çıkış Yap Butonu -->
        <a asp-controller ="Auth" asp-action="Logout" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-600 hover:bg-rose-50 border border-rose-200/70 transition-colors" title="Oturumu Kapat">
            <span class="material-symbols-outlined text-base">logout</span>
            <span class="hidden md:inline">Çıkış Yap</span>
        </a>
    </div>
</header>