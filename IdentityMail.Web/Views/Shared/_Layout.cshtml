<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>NovaConnect - Inbox</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet">

    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "on-primary-fixed": "#230f45",
                      "surface-container-highest": "#e1e3e4",
                      "tertiary-container": "#83b386",
                      "surface": "#f8f9fa",
                      "tertiary-fixed-dim": "#a2d3a4",
                      "error-container": "#ffdad6",
                      "on-primary": "#ffffff",
                      "on-primary-fixed-variant": "#503d73",
                      "inverse-primary": "#d3bcfc",
                      "on-surface-variant": "#49454f",
                      "secondary-container": "#84d7fd",
                      "on-background": "#191c1d",
                      "surface-container-lowest": "#ffffff",
                      "on-surface": "#191c1d",
                      "primary": "#68548d",
                      "surface-bright": "#f8f9fa",
                      "tertiary": "#3c6842",
                      "inverse-on-surface": "#f0f1f2",
                      "primary-fixed": "#ebdcff",
                      "surface-dim": "#d9dadb",
                      "on-error-container": "#93000a",
                      "tertiary-fixed": "#bdefbe",
                      "error": "#ba1a1a",
                      "surface-container-high": "#e7e8e9",
                      "surface-variant": "#e1e3e4",
                      "on-tertiary-container": "#194523",
                      "background": "#f8f9fa",
                      "primary-container": "#b39ddb",
                      "surface-container": "#edeeef",
                      "outline-variant": "#cbc4d0",
                      "on-tertiary-fixed": "#002109",
                      "primary-fixed-dim": "#d3bcfc",
                      "secondary-fixed-dim": "#7ed1f7",
                      "on-error": "#ffffff",
                      "on-secondary-container": "#005d79",
                      "outline": "#7a7580",
                      "surface-container-low": "#f3f4f5",
                      "on-secondary": "#ffffff",
                      "inverse-surface": "#2e3132",
                      "secondary-fixed": "#bee9ff",
                      "surface-tint": "#68548d",
                      "secondary": "#006685",
                      "on-primary-container": "#453268",
                      "on-secondary-fixed-variant": "#004d65",
                      "on-tertiary": "#ffffff",
                      "on-secondary-fixed": "#001f2a",
                      "on-tertiary-fixed-variant": "#24502c"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "container-max": "1200px",
                      "xl": "32px",
                      "sidebar-width": "280px",
                      "sm": "12px",
                      "base": "8px",
                      "lg": "24px",
                      "xs": "4px",
                      "md": "16px"
              },
              "fontFamily": {
                      "headline-lg-mobile": ["Inter"],
                      "headline-lg": ["Inter"],
                      "body-sm": ["Inter"],
                      "label-bold": ["Inter"],
                      "label-sm": ["Inter"],
                      "headline-xl": ["Inter"],
                      "body-lg": ["Inter"],
                      "title-md": ["Inter"]
              }
            }
          }
        }
    </script>
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(233, 236, 239, 0.5);
        }

        .soft-shadow {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        }
        /* Custom Scrollbar for better UI */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #d9dadb;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #cbc4d0;
            }
    </style>
</head>
<body class="bg-background text-on-background font-body-lg text-body-lg h-screen flex overflow-hidden">

    <!-- 1. SOL MENÜ (ASIDE) BURADA, EN DIŞTA -->
    @await Component.InvokeAsync("LayoutSidebar")

    <div class="flex-1 flex flex-col ml-0 md:ml-sidebar-width h-screen overflow-hidden">
        @RenderBody()
    </div>

    <script src="~/js/toggleStar.js"></script>
</body>

</html>

