@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NovaConnect Yönetici Paneli</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <!-- Google Material Symbols Outlined -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
          theme: {
            extend: {
              fontFamily: {
                sans: ['Inter', 'sans-serif'],
              },
              colors: {
                brand: {
                  50: '#f5f3ff',
                  100: '#ede9fe',
                  200: '#ddd6fe',
                  300: '#c4b5fd',
                  400: '#a78bfa',
                  500: '#8b5cf6',
                  600: '#7c3aed',
                  700: '#6d28d9',
                  800: '#5b21b6',
                  900: '#4c1d95',
                }
              },
              boxShadow: {
                'soft': '0 2px 10px -2px rgba(124, 58, 237, 0.05), 0 1px 3px 0 rgba(0, 0, 0, 0.04)',
                'soft-md': '0 8px 24px -4px rgba(124, 58, 237, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.04)',
              }
            }
          }
        }
    </script>

</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col">
    <!-- Mobil Üst Bar -->
    <div class="md:hidden flex items-center justify-between bg-white border-b border-slate-200/80 px-4 py-3 sticky top-0 z-50">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-purple-600 flex items-center justify-center text-white shadow-sm shadow-purple-600/30">
                <span class="material-symbols-outlined text-lg">forum</span>
            </div>
            <span class="font-bold text-slate-900 tracking-tight text-base">NovaConnect</span>
            <span class="text-[10px] font-bold px-2 py-0.5 bg-purple-100 text-purple-700 rounded-full uppercase tracking-wider">Admin</span>
        </div>
        <button class="p-2 text-slate-600 hover:text-purple-600 rounded-lg hover:bg-purple-50" onclick="toggleMobileNav()">
            <span class="material-symbols-outlined">menu</span>
        </button>
    </div>
    <!-- Mobil Drawer -->
    <div class="hidden md:hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs" id="mobile-nav" onclick="toggleMobileNav()">
        <div class="bg-white w-64 h-full p-4 flex flex-col shadow-2xl" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-3">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-purple-600 flex items-center justify-center text-white">
                        <span class="material-symbols-outlined text-lg">forum</span>
                    </div>
                    <span class="font-bold text-slate-900">NovaConnect</span>
                </div>
                <button class="text-slate-400 hover:text-slate-700" onclick="toggleMobileNav()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <nav class="space-y-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 text-left" toggleMobileNav()">
                    <span class="material-symbols-outlined text-lg">dashboard</span> Gösterge Paneli
                </a>
                <a asp-controller="AdminRoleAssign" asp-action="ListRole" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 text-left" toggleMobileNav()">
                    <span class="material-symbols-outlined text-lg">manage_accounts</span> Rol Yönetimi
                </a>
                <a asp-controller="Category" asp-action="Index" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 text-left" toggleMobileNav()">
                    <span class="material-symbols-outlined text-lg">category</span> Kategori Yönetimi
                </a>
                <a asp-controller="AdminReport" asp-action="Index" class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700 text-left" toggleMobileNav()">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-lg">report</span> Şikayet Edilen Mesajlar
                    </div>
                    <span class="text-[11px] px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 font-bold">12</span>
                </a>
            </nav>
        </div>
    </div>
    <!-- SOL SABİT SIDEBAR (w-64 fixed h-full bg-white border-r border-slate-200/80) -->
    @await Component.InvokeAsync("AdminLayoutSidebar")
    <!-- SAĞ İÇERİK ALANI -->
    <div class="md:ml-64 flex-1 flex flex-col min-w-0">
        <!-- ÜST NAVBAR (h-16 bg-white/90 backdrop-blur border-b border-slate-200/80 px-8 flex items-center justify-between sticky top-0 z-20) -->
        @await Component.InvokeAsync("AdminLayoutHeader")
        <!-- ANA İÇERİK ALANI (SPA GÖRÜNÜMLERİ) -->
        <main class="flex-1 p-6 md:p-8 max-w-7xl w-full mx-auto">

            @RenderBody()
           
        </main>
    </div>
    <!-- Mobil Menü Aç/Kapat Fonksiyonu -->
    <script>
        function toggleMobileNav() {
            var nav = document.getElementById('mobile-nav');
            if (nav) {
                nav.classList.toggle('hidden');
            }
        }
    </script>
</body>
</html>