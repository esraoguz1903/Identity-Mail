@model ProfileDto
@{
    ViewData["Title"] = "Profil Ayarları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Sayfanın tam ortasına hizalamak için ana kapsayıcı -->
<main class="flex-1 flex flex-col justify-center items-center p-4 md:p-8 w-full min-h-[85vh]">

    <!-- ZARİF BEYAZ KART (Her şey bu kartın içinde) -->
    <div class="w-full max-w-2xl bg-white rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 p-8 md:p-12 relative overflow-hidden">

        <!-- Üst Başlık (Ortalanmış) -->
        <div class="mb-10 text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-slate-800">Profil Ayarları</h2>
            <p class="text-slate-500 mt-2 text-sm">Kişisel bilgilerinizi buradan güncelleyebilirsiniz.</p>
        </div>

        <form asp-controller="Profile" asp-action="EditProfile" method="post" enctype="multipart/form-data">

            <!-- Profil Resmi ve Değiştirme Butonu (Ortalanmış) -->
            <div class="flex flex-col items-center gap-5 mb-10">

                <!-- Yuvarlak Resim -->
                <div class="w-28 h-28 rounded-full border-4 border-purple-50 shadow-md flex items-center justify-center bg-slate-50 overflow-hidden shrink-0">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img alt="Profil" class="w-full h-full object-cover" src="/@Model.ProfileImageUrl" />
                    }
                    else
                    {
                        <span class="text-4xl font-black text-slate-300">@Model.FirstName.Substring(0, 1)</span>
                    }
                </div>

                <!-- Gizli File Input ile Özel Tasarım Buton -->
                <div class="relative inline-block overflow-hidden rounded-full">
                    <!-- Gerçek Input (Görünmez) -->
                    <input asp-for="ProfileImage" type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                    <!-- Görünen Şık Buton -->
                    <button type="button" class="bg-purple-50 text-purple-600 font-semibold py-2 px-6 rounded-full text-sm flex items-center gap-2 pointer-events-none transition-colors group-hover:bg-purple-100">
                        <span class="material-symbols-outlined text-[18px]">photo_camera</span> Fotoğraf Değiştir
                    </button>
                </div>
            </div>

            <!-- Ad ve Soyad Giriş Alanları -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider" for="FirstName">Adınız</label>
                    <input asp-for="FirstName" class="w-full bg-slate-50 hover:bg-slate-100 focus:bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-slate-800 font-medium focus:border-purple-500 focus:ring-4 focus:ring-purple-500/10 transition-all outline-none" type="text" />
                </div>
                <div class="flex flex-col gap-2">
                    <label class="text-xs font-bold text-slate-500 uppercase tracking-wider" for="LastName">Soyadınız</label>
                    <input asp-for="LastName" class="w-full bg-slate-50 hover:bg-slate-100 focus:bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-slate-800 font-medium focus:border-purple-500 focus:ring-4 focus:ring-purple-500/10 transition-all outline-none" type="text" />
                </div>
            </div>

            <!-- Kaydet Butonu (Geniş ve Dikkat Çekici) -->
            <div class="flex justify-center mt-2">
                <button type="submit" class="w-full md:w-auto bg-purple-600 hover:bg-purple-700 text-white font-bold py-3.5 px-12 rounded-full shadow-lg shadow-purple-600/20 hover:shadow-xl hover:-translate-y-0.5 transition-all active:scale-95 flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">save</span> Değişiklikleri Kaydet
                </button>
            </div>

        </form>
    </div>
</main>