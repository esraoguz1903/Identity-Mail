@model List<ReportMessageDto>
@{
    ViewData["Title"] = "Şikayet Edilen Mesajlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!-- ========================================================================= -->
<!-- 4. ŞİKAYET EDİLEN MESAJLAR BÖLÜMÜ (#view-reports)                         -->
<!-- ========================================================================= -->
<section class="view-section space-y-6" id="view-reports">
    <!-- Başlık: "Şikayet Edilen Mesajlar & Moderasyon", yanında '12 Bekleyen İncelenmemiş Şikayet' uyarısı -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <h2 class="text-lg font-bold text-slate-900">Şikayet Edilen Mesajlar &amp; Moderasyon</h2>
            <p class="text-xs text-slate-500">Topluluk kurallarını ihlal ettiği bildirilen mesajları inceleyin ve karar verin.</p>
        </div>
    </div>
    @foreach(var item in Model)
    {
        <!-- Gelen kutusu tarzında alt alta şık kartlar (3 detaylı şikayet vakası örneği) -->
        <div class="space-y-4">
            <!-- Vaka 1: Uygunsuz Dil / Hakaret -->
            <div class="bg-white rounded-xl border border-slate-200/80 shadow-soft p-5 sm:p-6 hover:shadow-soft-md transition-all">
                <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
                    <!-- Sol Kısım: Detaylar & Mesaj Özeti -->
                    <div class="space-y-3 flex-1">
                        <div class="flex flex-wrap items-center gap-3">
                            <!-- Şikayet Eden Kişi (avatarı ve adı) -->
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-700 text-xs font-bold flex items-center justify-center">
                                    @item.ReceiverFirstName.Substring(0,1)@item.ReceiverLastName.Substring(0,1)
                                </div>
                                <span class="text-xs text-slate-600 font-medium">Şikayet Eden: <strong class="text-slate-900">@item.ReceiverFirstName @item.ReceiverLastName</strong></span>
                            </div>
                            <span class="text-slate-300">•</span>
                            <!-- Canlı Kırmızı Badge -->
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-100 text-rose-700 border border-rose-200">
                                <span class="material-symbols-outlined text-xs">gpp_bad</span> @item.ReportReason
                            </span>
                            <span class="text-slate-300">•</span>
                            <!-- Gönderim Tarihi ve Saati -->
                            <span class="text-[11px] text-slate-400 flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">schedule</span> @item.SendDate
                            </span>
                        </div>
                        <!-- Şikayet Edilen Mesajın Kısa Özeti (gri arka planlı metin alanı) -->
                        <div class="bg-slate-50 border-l-4 border-rose-500 rounded-r-lg p-3.5 text-xs text-slate-700 leading-relaxed font-sans">
                            <span class="font-semibold text-slate-900">Şikayet Edilen Mesaj:</span>
                            <p class="mt-1 italic">@item.Body</p>
                        </div>
                        <!-- Ek Bilgiler -->
                        <div class="text-[11px] text-slate-500 flex flex-wrap items-center gap-3">
                            <span>Şüpheli Kullanıcı: <strong class="text-slate-700 font-mono">@item.SenderFirstName @item.SenderLastName</strong></span>
                        </div>
                    </div>
                    <!-- Sağ Kısım: Aksiyon Butonları -->
                    <div class="flex lg:flex-col items-center lg:items-end gap-2 shrink-0 pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-100">
                        <!-- Mesajı İncele (mor/indigo buton) -->
                        <a asp-controller="AdminReport" asp-action="InspectMessage" asp-route-id="@item.Id" class="w-full sm:w-auto px-3.5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-semibold shadow-xs flex items-center justify-center gap-1.5 transition-colors">
                            <span class="material-symbols-outlined text-sm">visibility</span> Mesajı İncele
                        </a>
                        <!-- Kullanıcıyı Uyar (turuncu/kırmızı kenarlıklı buton) -->
                        <form asp-controller="AdminRoleAssign" asp-action="WarningUser" method="post">
                            <input type="hidden" name="senderId" value="@item.SenderId"/>
                            <input type="hidden" name="messageId" value="@item.Id"/>
                        <button class="w-full sm:w-auto px-3.5 py-2 bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-300 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors">
                            <span class="material-symbols-outlined text-sm">warning</span> Kullanıcıyı Uyar
                        </button>
                        </form>
                        <!-- Şikayeti Yoksay (nötr gri buton) -->
                        <a asp-controller="AdminReport" asp-action="DismissReport" asp-route-id="@item.Id" class="w-full sm:w-auto px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors">
                            <span class="material-symbols-outlined text-sm">close</span> Şikayeti Yoksay
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
   
</section>

