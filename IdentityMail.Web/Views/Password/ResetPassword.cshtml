<body class="bg-background min-h-screen flex items-center justify-center font-body-lg text-body-lg text-on-background">
    <div class="flex w-full h-screen lg:flex-row flex-col">
        <!-- Left Side: Abstract Branding Area -->
        <div class="lg:w-1/2 w-full relative overflow-hidden bg-surface-container flex flex-col justify-center items-center p-xl lg:h-full h-[409px]">
            <div class="absolute inset-0 w-full h-full bg-cover bg-center opacity-80 mix-blend-multiply" data-alt="A soft, abstract digital art background composed of flowing lavender and white gradient mesh. The lighting is very soft and diffused, creating a calm, professional, and inviting atmosphere suitable for a corporate application landing page. Gentle curves and blurred edges evoke a sense of connectivity and modern glassmorphism. Subtle pastel purple tones dominate, with minimal distractions." style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBRxqZfw_f6nSE47IYRPxM98ECjP_36_IHinyyBy_XHsUMnxWhidL6VtfyyuvrAjhpmz7SsjdbUVr3utU5QBVkdwF7wSZbUndTanhIb4B5PZcaNaq_NagsyX_cnsTa2YUERAErg2yUM-WKAaFp2lONhXVhvjjmu6sKzEM3lUrqZNb4ewdqCjV41z1ECpwNHhQeFIENedciGbPnnkPnY5HItLbDDMJ5vYD9CRfCiWh1F63Qbbo5p2ac')"></div>
            <div class="relative z-10 max-w-md w-full bg-white/10 backdrop-blur-xl border border-white/20 p-xl rounded-[24px] shadow-[0_8px_32px_0_rgba(104,84,141,0.1)] text-center">
                <div class="w-16 h-16 mx-auto mb-lg bg-primary text-on-primary rounded-full flex items-center justify-center">
                    <span class="material-symbols-outlined text-4xl" data-icon="hub">hub</span>
                </div>
                <h1 class="font-headline-xl text-headline-xl text-on-background mb-sm">NovaConnect</h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant">Kurumsal iletişimin en tatlı hali.</p>
            </div>
            <!-- Subtle floating shapes for depth -->
            <div class="absolute top-1/4 left-1/4 w-32 h-32 bg-primary/10 rounded-full blur-3xl animate-pulse"></div>
            <div class="absolute bottom-1/4 right-1/4 w-48 h-48 bg-secondary/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
        </div>
        <!-- Right Side: Reset Password Form -->
        <div class="lg:w-1/2 w-full flex items-center justify-center p-xl bg-surface lg:h-full h-[614px] lg:-ml-0 -mt-6 lg:mt-0 rounded-t-[32px] lg:rounded-none z-20">
            <div class="w-full max-w-sm">
                <div class="mb-xl text-center">
                    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs hidden md:block">Yeni Şifre Belirle</h2>
                    <h2 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface mb-xs md:hidden block">Yeni Şifre Belirle</h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Hesabın için yeni ve güvenli bir şifre oluştur.</p>
                </div>
                <form asp-controller="Password" asp-action="ResetPassword" method="post" class="space-y-lg flex flex-col">
                    <input asp-for="Email" type="hidden"/>
                    <input asp-for="Token" type="hidden"/>
                    <!-- Password Input 1 -->
                    <div class="space-y-xs">
                        <label class="font-label-sm text-label-sm text-on-surface-variant pl-xs" for="new_password">Yeni Şifre</label>
                        <div class="relative flex items-center">
                            <span class="material-symbols-outlined absolute left-sm text-outline-variant pointer-events-none" data-icon="lock">lock</span>
                            <input asp-for="NewPassword" class="w-full bg-white border border-outline-variant text-on-surface rounded-xl py-sm pl-10 pr-10 focus:ring-2 focus:ring-secondary/50 focus:border-secondary transition-all outline-none font-body-lg text-body-lg placeholder:text-outline-variant" placeholder="••••••••" type="password" />
                            <button aria-label="Toggle password visibility" class="absolute right-sm text-outline-variant hover:text-on-surface transition-colors focus:outline-none flex items-center" type="button">
                                <span class="material-symbols-outlined" data-icon="visibility_off">visibility_off</span>
                            </button>
                        </div>
                    </div>
                    <!-- Password Input 2 -->
                    <div class="space-y-xs">
                        <label class="font-label-sm text-label-sm text-on-surface-variant pl-xs" for="confirm_password">Yeni Şifre (Tekrar)</label>
                        <div class="relative flex items-center">
                            <span class="material-symbols-outlined absolute left-sm text-outline-variant pointer-events-none" data-icon="lock_reset">lock_reset</span>
                            <input asp-for="ConfirmPassword" class="w-full bg-white border border-outline-variant text-on-surface rounded-xl py-sm pl-10 pr-10 focus:ring-2 focus:ring-secondary/50 focus:border-secondary transition-all outline-none font-body-lg text-body-lg placeholder:text-outline-variant"  placeholder="••••••••" type="password" />
                            <button aria-label="Toggle password visibility" class="absolute right-sm text-outline-variant hover:text-on-surface transition-colors focus:outline-none flex items-center" type="button">
                                <span class="material-symbols-outlined" data-icon="visibility_off">visibility_off</span>
                            </button>
                        </div>
                    </div>
                    <!-- Submit Button -->
                    <button class="w-full bg-primary hover:bg-primary/90 text-on-primary rounded-full py-sm px-lg font-label-bold text-label-bold transition-colors shadow-sm hover:shadow-md flex justify-center items-center gap-2" type="submit">
                        Şifreyi Güncelle
                    </button>
                    <div class="text-center pt-md">
                        <a class="font-label-sm text-label-sm text-primary hover:text-primary/80 transition-colors inline-flex items-center gap-1" href="#">
                            <span class="material-symbols-outlined text-[16px]" data-icon="arrow_back">arrow_back</span>
                            Giriş ekranına dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>