@model ForgotPasswordDto
@{
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>NovaConnect - Şifremi Unuttum</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "on-secondary": "#ffffff",
                        "surface-variant": "#e1e3e4",
                        "surface-container-highest": "#e1e3e4",
                        "on-tertiary": "#ffffff",
                        "tertiary-fixed": "#bdefbe",
                        "surface-dim": "#d9dadb",
                        "on-primary-fixed": "#230f45",
                        "on-background": "#191c1d",
                        "surface-container": "#edeeef",
                        "inverse-surface": "#2e3132",
                        "tertiary-fixed-dim": "#a2d3a4",
                        "secondary-fixed": "#bee9ff",
                        "on-error-container": "#93000a",
                        "outline-variant": "#cbc4d0",
                        "on-surface": "#191c1d",
                        "inverse-primary": "#d3bcfc",
                        "surface-tint": "#68548d",
                        "surface-container-high": "#e7e8e9",
                        "tertiary-container": "#83b386",
                        "secondary": "#006685",
                        "primary-fixed-dim": "#d3bcfc",
                        "on-tertiary-fixed": "#002109",
                        "on-tertiary-fixed-variant": "#24502c",
                        "on-tertiary-container": "#194523",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "surface": "#f8f9fa",
                        "on-secondary-fixed-variant": "#004d65",
                        "on-surface-variant": "#49454f",
                        "on-primary-container": "#453268",
                        "primary-fixed": "#ebdcff",
                        "on-primary-fixed-variant": "#503d73",
                        "tertiary": "#3c6842",
                        "surface-bright": "#f8f9fa",
                        "inverse-on-surface": "#f0f1f2",
                        "on-secondary-fixed": "#001f2a",
                        "primary": "#68548d",
                        "on-secondary-container": "#005d79",
                        "secondary-container": "#84d7fd",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "outline": "#7a7580",
                        "surface-container-lowest": "#ffffff",
                        "background": "#f8f9fa",
                        "surface-container-low": "#f3f4f5",
                        "secondary-fixed-dim": "#7ed1f7",
                        "primary-container": "#b39ddb"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px",
                        "16": "16px"
                    },
                    "spacing": {
                        "base": "8px",
                        "xl": "32px",
                        "sidebar-width": "280px",
                        "md": "16px",
                        "xs": "4px",
                        "sm": "12px",
                        "container-max": "1200px",
                        "lg": "24px"
                    },
                    "fontFamily": {
                        "body-lg": ["Inter"],
                        "headline-xl": ["Inter"],
                        "label-bold": ["Inter"],
                        "body-sm": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "label-sm": ["Inter"],
                        "title-md": ["Inter"],
                        "headline-lg": ["Inter"]
                    },
                    "fontSize": {
                        "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-xl": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-bold": ["12px", { "lineHeight": "16px", "fontWeight": "600" }],
                        "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "title-md": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }]
                    }
                },
            },
        }
    </script>
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .bg-gradient-brand {
            background: linear-gradient(135deg, #d3bcfc 0%, #b39ddb 50%, #68548d 100%);
        }
    </style>
</head>
<body class="bg-background min-h-screen flex items-center justify-center font-body-lg text-on-background m-0 p-0 overflow-x-hidden">
    <main class="w-full h-screen flex flex-col md:flex-row">
        <!-- Left Side: Branding / Visuals (Hidden on small screens) -->
        <section class="hidden md:flex flex-col justify-center items-center w-1/2 bg-gradient-brand relative overflow-hidden p-xl">
            <!-- Decorative Elements -->
            <div class="absolute top-[-10%] left-[-10%] w-[400px] h-[400px] bg-white opacity-10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-[-10%] right-[-10%] w-[500px] h-[500px] bg-primary opacity-20 rounded-full blur-3xl"></div>
            <!-- Branding Card -->
            <div class="glass-panel rounded-16 p-xl max-w-md w-full relative z-10 shadow-lg text-center transform hover:scale-[1.02] transition-transform duration-300">
                <div class="flex items-center justify-center mb-md">
                    <span class="material-symbols-outlined text-primary-fixed-dim text-[48px] mr-sm" style="font-variation-settings: 'FILL' 1;">forum</span>
                    <h1 class="font-headline-lg text-headline-lg text-on-surface">NovaConnect</h1>
                </div>
                <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                    Kurumsal iletişimi daha insancıl, sakin ve davetkar bir hale getiriyoruz.
                    Bağlantıda kalın, üretkenliği artırın.
                </p>
                <div class="mt-lg flex justify-center gap-sm">
                    <div class="w-2 h-2 rounded-full bg-primary-fixed-dim"></div>
                    <div class="w-8 h-2 rounded-full bg-primary"></div>
                    <div class="w-2 h-2 rounded-full bg-primary-fixed-dim"></div>
                </div>
            </div>
        </section>
        <!-- Right Side: Forgot Password Form -->
        <section class="w-full md:w-1/2 h-full flex items-center justify-center p-md md:p-xl bg-surface-container-lowest">
            <div class="w-full max-w-md">
                <!-- Mobile Logo (Visible only on small screens) -->
                <div class="flex md:hidden items-center justify-center mb-xl">
                    <span class="material-symbols-outlined text-primary text-[32px] mr-sm" style="font-variation-settings: 'FILL' 1;">forum</span>
                    <h2 class="font-title-md text-title-md text-primary">NovaConnect</h2>
                </div>
                <!-- Header -->
                <div class="mb-xl text-center md:text-left">
                    <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-background mb-base">Şifreni mi Unuttun?</h1>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">
                        Endişelenme! E-posta adresini gir, sana şifre sıfırlama bağlantısı gönderelim.
                    </p>
                </div>
                <!-- Form -->
                <form asp-action="ForgotPassword" asp-controller="Password" class="space-y-lg" method="post">
                    <!-- Email Input -->
                    <div>
                        <label class="block font-label-bold text-label-bold text-on-surface mb-xs" for="email">E-posta</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">
                                <span class="material-symbols-outlined text-outline">mail</span>
                            </div>
                            <input asp-for="Email" aria-label="E-posta Adresi" class="w-full pl-[40px] pr-sm py-sm bg-surface-container-lowest border border-outline-variant rounded-[12px] text-on-surface focus:outline-none focus:ring-2 focus:ring-secondary-container focus:border-secondary-container transition-all placeholder-outline" placeholder="ornek@sirket.com" required="" type="email" />
                        </div>
                    </div>
                    <!-- Submit Button -->
                    <button class="w-full bg-primary-container text-on-primary-container hover:bg-primary hover:text-on-primary font-title-md text-title-md py-sm px-lg rounded-full transition-colors duration-200 shadow-sm flex items-center justify-center group" type="submit">
                        <span>Sıfırlama Bağlantısı Gönder</span>
                        <span class="material-symbols-outlined ml-sm opacity-0 group-hover:opacity-100 transform -translate-x-2 group-hover:translate-x-0 transition-all duration-200">arrow_forward</span>
                    </button>
                    @if (ViewBag.resetLinkMessage != null)
                    {
                        <!-- Başarılı Mesaj Kutusu -->
                        <div class="mb-lg p-md rounded-xl bg-tertiary-container/20 border border-tertiary text-on-tertiary-container flex items-start animate-fade-in">
                            <span class="material-symbols-outlined mr-sm text-tertiary">check_circle</span>
                            <p class="font-body-sm text-body-sm pt-1">@ViewBag.resetLinkMessage</p>
                        </div>
                    }
                </form>
                <!-- Back to Login Link -->
                <div class="mt-lg text-center">
                    <a class="font-body-sm text-body-sm text-primary hover:text-surface-tint flex items-center justify-center transition-colors" href="/Auth/Login">
                        <span class="material-symbols-outlined mr-xs text-[18px]">arrow_back</span>
                        Giriş Ekranına Dön
                    </a>
                </div>
                <!-- Support Link -->
                <div class="mt-xl pt-lg border-t border-surface-variant text-center">
                    <p class="font-label-sm text-label-sm text-outline">
                        Yardıma mı ihtiyacın var? <a class="text-primary hover:underline" href="#">Destek ile iletişime geç</a>
                    </p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>